{
  "name": "pi-htmldoc",
  "version": "0.1.3",
  "description": "Free artifact publishing for Pi: share any HTML or Markdown file your agent writes as a link anyone can open. One tool call, no deploy, no hosting.",
  "license": "MIT",
  "type": "module",
  "files": [
    "extensions",
    "lib",
    "skills"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\""
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-skill",
    "artifacts",
    "publish",
    "share",
    "share-link",
    "html",
    "markdown",
    "hosting",
    "htmldoc"
  ],
  "pi": {
    "extensions": [
      "./extensions/htmldoc.ts"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/ajaxray/pi-htmldoc/main/docs/preview.png"
  },
  "dependencies": {
    "htmldoc-cli": "^0.2.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "homepage": "https://htmldoc.space",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajaxray/pi-htmldoc.git"
  },
  "bugs": {
    "url": "https://github.com/ajaxray/pi-htmldoc/issues"
  },
  "author": "Anis Ahmad"
}
