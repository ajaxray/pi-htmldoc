{
  "name": "pi-htmldoc",
  "version": "0.1.1",
  "description": "Pi package: publish a local HTML or Markdown file to an htmldoc.space share link with one tool call, sign-in included.",
  "license": "MIT",
  "type": "module",
  "files": [
    "extensions",
    "lib",
    "skills"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\""
  },
  "keywords": [
    "pi-package",
    "pi",
    "htmldoc",
    "share",
    "publish",
    "html",
    "markdown"
  ],
  "pi": {
    "extensions": [
      "./extensions/htmldoc.ts"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://htmldoc.space/og.png"
  },
  "dependencies": {
    "htmldoc-cli": "^0.2.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "homepage": "https://htmldoc.space",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajaxray/pi-htmldoc.git"
  },
  "bugs": {
    "url": "https://github.com/ajaxray/pi-htmldoc/issues"
  },
  "author": "Anis Ahmad"
}
